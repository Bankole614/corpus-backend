# Copy to .env and fill in real values. Never commit the real .env.
GEMINI_API_KEY=
ENVIRONMENT=development
PORT=8003
VERIFICATION_MODEL=gemini-2.5-flash
CONCIERGE_MODEL=gemini-2.5-flash
# CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# Defaults to local SQLite if unset. For Postgres:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/corpus
DATABASE_URL=sqlite+aiosqlite:///./corpus.db


