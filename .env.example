# Copy to .env and fill in real values. Never commit the real .env.
GEMINI_API_KEY=
ENVIRONMENT=development
PORT=8003
VERIFICATION_MODEL=gemini-3.6-flash
CONCIERGE_MODEL=gemini-3.6-flash
# CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# Defaults to local SQLite if unset. For Postgres:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/corpus
DATABASE_URL=sqlite+aiosqlite:///./corpus.db

# Authentication
JWT_SECRET_KEY=replace-with-a-secure-random-secret
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# ADMIN_API_KEY=your-super-secret-admin-key

# Transactional Email (Brevo)
# BREVO_API_KEY=xkeysib-your-brevo-api-key-here
# BREVO_SENDER_EMAIL=noreply@mail.bankole.xyz
# BREVO_SENDER_NAME=Corpus
# FRONTEND_URL=http://localhost:3000

# Rate Limiting
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_STORAGE_URL=memory://
# For distributed Redis storage in production:
# RATE_LIMIT_STORAGE_URL=redis://localhost:6379/0
# RATE_LIMIT_AUTH=10/minute
# RATE_LIMIT_FORGOT_PASSWORD=3/minute
# RATE_LIMIT_VERIFY=15/minute
# RATE_LIMIT_CONCIERGE_CHAT=20/minute
# RATE_LIMIT_CONCIERGE_BRIEF=5/minute
# RATE_LIMIT_DEFAULT=100/minute


