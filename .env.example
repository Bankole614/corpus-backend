# Copy to .env and fill in real values. Never commit the real .env.
GEMINI_API_KEY=
ENVIRONMENT=development
PORT=8003
VERIFICATION_MODEL=gemini-3.6-flash
CONCIERGE_MODEL=gemini-3.6-flash
# CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# Defaults to local SQLite if unset. For Postgres:
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/corpus
DATABASE_URL=sqlite+aiosqlite:///./corpus.db

# Authentication
JWT_SECRET_KEY=replace-with-a-secure-random-secret
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# ADMIN_API_KEY=your-super-secret-admin-key

# Transactional Email (Brevo)
# BREVO_API_KEY=xkeysib-your-brevo-api-key-here
# EMAILS_FROM_EMAIL=noreply@yourdomain.com
# EMAILS_FROM_NAME=Corpus
# FRONTEND_URL=http://localhost:3000


